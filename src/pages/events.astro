---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import WeekCalendar from '../components/WeekCalendar.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { pvpEvents, pvpCommon, instances, attendance } from '../data/events';
import { epicBosses } from '../data/bosses';

const glory = [
  {
    icon: 'laurel' as const,
    title: '奧林匹亞',
    when: '週一～週六 22:00～23:00',
    items: [
      '70 級以上、完成二轉、使用主職業才能參加。',
      '每天最多 5 場，不分職業賽，報名滿 20 人開始配對。',
      '每場勝者得特級 HP 藥水 ×10，敗者 ×1。',
      '每週一 00:00 結算：各職業積分最高、當週打滿 10 場且至少贏 1 場的人成為英雄。',
      '英雄只能從奧林匹亞取得，不販售。同一台電腦只能 1 個角色報名。',
    ],
  },
  {
    icon: 'siege' as const,
    title: '奇岩城攻城戰',
    when: '每週日 20:00～21:00',
    items: [
      '目前開放奇岩城，每週日 20:00 開打，持續 1 小時。',
      '每場最多 20 個血盟參加。',
      '攻城戰中死亡不扣經驗；攻城區域內不能使用布告欄和內掛。',
      '攻城中的城鎮無法用布告欄傳送進入。',
    ],
  },
  {
    icon: 'fangs' as const,
    title: '血盟與盟戰',
    when: '血盟 Lv.10・同盟最多 3 盟',
    items: [
      '血盟最高 10 級，同盟最多 3 個血盟。',
      '最多同時對 30 個血盟宣戰；被宣戰方反擊殺 5 人後成為互相宣戰。',
      '互相宣戰中每擊殺 1 名敵對成員，血盟聲望 +1；被敵對血盟殺死只扣 1% 經驗。',
      '血盟解散與更換盟主在每週六 21:00 生效。',
    ],
  },
];

/** PvP 活動卡片：第一列「時間」拉到標題列，其餘留在表格 */
const duels = pvpEvents.map((ev) => ({
  ...ev,
  when: ev.rows.find(([k]) => k === '時間')?.[1] ?? '',
  rest: ev.rows.filter(([k]) => k !== '時間'),
}));
---

<Base title="每週戰場" description="嗜血天堂II 經典服每週活動：TvT 團體對抗賽、最後的英雄、週二 PvP 區域、奧林匹亞、奇岩攻城戰，以及史詩首領重生時間、副本與每日出席獎勵。">
  <PageHero
    crumb="每週戰場"
    title="每週戰場"
    lead="今晚，戰場在哪裡"
    desc="週一到週六每晚都有 PvP 活動與奧林匹亞，週二開放 PvP 區域，週日奇岩攻城。所有時間皆為伺服器時間（台灣時間 UTC+8）。"
  />

  <section class="section" aria-labelledby="e-cal">
    <div class="container">
      <SectionHead title="每週行事曆" id="e-cal" desc="依台灣時間即時標示今天與下一場活動。每週一、四、六 21:00 例行重啟，重啟前有倒數公告。" />
      <WeekCalendar />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="e-pvp">
    <div class="container">
      <SectionHead title="PvP 活動" id="e-pvp" desc="週一到週六晚上各有一場，報名時會跳出確認視窗。" />
      <div class="duel">
        {
          duels.map((ev) => (
            <article class="duel__card card">
              <header class="duel__head bar">
                <span class="medal" aria-hidden="true">
                  <Icon name={ev.icon} />
                </span>
                <div class="duel__names">
                  <h3 class="duel__name">{ev.name}</h3>
                  <p class="duel__latin">{ev.latin}</p>
                </div>
                <p class="duel__when">
                  <Icon name="clock" />
                  <span class="sr-only">時間：</span>
                  {ev.when}
                </p>
              </header>
              <div class="duel__body">
                <table class="duel__rows">
                  <caption class="sr-only">{ev.name}規則</caption>
                  <tbody>
                    {ev.rest.map(([k, v]) => (
                      <tr>
                        <th scope="row">{k}</th>
                        <td>{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <div class="duel__reward">
                  <p class="duel__reward-h">
                    <Icon name="coins" />
                    獎勵
                  </p>
                  {ev.reward.map(([k, v]) => (
                    <p>
                      <b>{k}</b>
                      {v}
                    </p>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <ul class="bullets duel__common">
        {pvpCommon.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- 週二 PvP 區域：深色夜景區塊，附一條 20:00～24:00 的時間軸 -->
  <section class="section section--dark zone-band" aria-labelledby="e-zone">
    <svg class="edge edge--trees" viewBox="0 0 2400 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <use href="#g-trees"></use>
    </svg>
    <div class="starfield" aria-hidden="true"></div>

    <div class="container zone">
      <div class="zone__date tnum" aria-hidden="true">
        <span>每週二</span>
        <b>20:00</b>
        <i></i>
        <b>24:00</b>
      </div>
      <div class="zone__text">
        <h2 class="zone__title" id="e-zone">週二 PvP 區域：殺人不會變紅名</h2>
        <p class="zone__desc">
          每週二 20:00～24:00，<b>安塔瑞斯洞窟</b>與<b>傲慢之塔 4～11 樓</b>的活動區域變成 PvP 區，在裡面殺人不會變紅名。
        </p>
        <ul class="bullets zone__list">
          <li>活動怪物每隻都會掉 1 個「防具材料禮盒－A 級」或「飾品材料禮盒－A 級」。</li>
          <li>20:30 與 22:30 各出現 3～4 隻「血的騎士團長」，停留 30 分鐘，打倒掉「防具禮盒－A 級」或「飾品禮盒－A 級」。</li>
          <li>區域內內掛會自動停止。</li>
        </ul>

        <!-- 時間軸：四小時，兩段金色是「血的騎士團長」出現的 30 分鐘 -->
        <div class="zone__line tnum" aria-hidden="true">
          <p class="zone__line-cap"><i></i>血的騎士團長出現（各 30 分鐘）</p>
          <div class="zone__track">
            <span class="zone__spawn" style="left:12.5%"></span>
            <span class="zone__spawn" style="left:62.5%"></span>
          </div>
          <ol class="zone__ticks">
            <li style="left:0">20:00</li>
            <li class="is-hit" style="left:12.5%">20:30</li>
            <li style="left:50%">22:00</li>
            <li class="is-hit" style="left:62.5%">22:30</li>
            <li style="left:100%">24:00</li>
          </ol>
        </div>
      </div>
    </div>

    <svg class="edge edge--range" viewBox="0 0 2400 160" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <use href="#g-mid-body"></use>
    </svg>
  </section>

  <section class="section" aria-labelledby="e-glory">
    <div class="container">
      <SectionHead title="英雄、城堡與血盟" id="e-glory" />
      <div class="glory">
        {
          glory.map((g) => (
            <article class="glory__item card">
              <header class="glory__head">
                <span class="medal" aria-hidden="true">
                  <Icon name={g.icon} />
                </span>
                <div>
                  <h3 class="glory__t">{g.title}</h3>
                  <p class="glory__when">{g.when}</p>
                </div>
              </header>
              <ul class="bullets glory__list">
                {g.items.map((t) => <li>{t}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" id="bosses" aria-labelledby="e-boss">
    <div class="container">
      <SectionHead
        title="首領重生與副本"
        id="e-boss"
        desc="時間皆為伺服器時間，一般怪的重生加速不影響首領。史詩首領都是 96 級：玩家等級最多以 90 計算，87 級以下魔法傷害只剩 1、93 級以下傷害會打折。"
      />
      <div class="table-wrap e-table">
        <table class="table">
          <caption class="sr-only">史詩首領重生時間</caption>
          <thead>
            <tr>
              <th scope="col">史詩首領</th>
              <th scope="col">等級</th>
              <th scope="col">地點</th>
              <th scope="col">進入條件</th>
              <th scope="col">重生</th>
              <th scope="col">代表掉落</th>
            </tr>
          </thead>
          <tbody>
            {
              epicBosses.map((b) => (
                <tr>
                  <th scope="row">
                    <span class="e-boss">
                      <span class="medal" aria-hidden="true">
                        <Icon name={b.icon} />
                      </span>
                      {b.name}
                    </span>
                  </th>
                  <td class="tnum" data-label="等級">
                    <span class="e-lv">Lv.{b.level}</span>
                  </td>
                  <td class="e-span2" data-label="地點">{b.location}</td>
                  <td class="e-full" data-label="進入條件">{b.entry}</td>
                  <td class="e-full" data-label="重生">{b.respawn}</td>
                  <td class="e-full" data-label="代表掉落">{b.drops.join('、')}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3 class="e-sub">副本一覽<span>每週三 06:30 重置，多數副本打倒首領才會被鎖</span></h3>
      <div class="table-wrap e-table">
        <table class="table">
          <caption class="sr-only">副本一覽</caption>
          <thead>
            <tr>
              <th scope="col">副本</th>
              <th scope="col">等級</th>
              <th scope="col">人數</th>
              <th scope="col">時限</th>
              <th scope="col">主要獎勵</th>
            </tr>
          </thead>
          <tbody>
            {
              instances.map((x) => (
                <tr>
                  <th scope="row">
                    {x.name}
                    <span class="e-inst-sub">{x.sub}</span>
                  </th>
                  <td class="tnum e-nowrap" data-label="等級">{x.lv}</td>
                  <td class="e-nowrap" data-label="人數">{x.party}</td>
                  <td class="e-nowrap" data-label="時限">{x.time}</td>
                  <td class="e-reward e-full" data-label="主要獎勵">{x.reward}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="e-att">
    <div class="container">
      <SectionHead
        title="28 天出席獎勵"
        id="e-att"
        desc="每天登入可領一次（以帳號計），每天 06:30 重置。一般帳號在線 30 分鐘後可領，高級會員登入就能領。一輪共 600 出席幣，可到布告欄「出席幣兌換所」換道具。"
      />
      <div class="att">
        {
          attendance.map((week, w) => (
            <div class="att__week">
              <p class="att__wk">
                <span>第</span>
                <b class="tnum">{w + 1}</b>
                <span>週</span>
              </p>
              <ol class="att__days">
                {week.map((r, d) => (
                  <li class:list={['att__day', d === 0 && 'is-coin', d === 6 && 'is-final']}>
                    <span class="att__n tnum">第 {w * 7 + d + 1} 天</span>
                    <span class="att__r">{r}</span>
                    {d === 0 && <Icon name="coins" class="att__ico" />}
                    {d === 6 && <Icon name="chest" class="att__ico" />}
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
      <p class="att__legend">
        <span class="att__key is-coin"><i aria-hidden="true"></i>每週第 1 天：出席幣</span>
        <span class="att__key is-final"><i aria-hidden="true"></i>每週第 7 天：特別獎勵</span>
      </p>
    </div>
  </section>

  <CtaBand title="戰場已經就位" desc="下載客戶端、加入 Discord，第一時間收到活動與維護公告。" />
</Base>

<style>
  /* ---------- PvP 活動 ---------- */
  .duel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .duel__card {
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-2);
  }
  .duel__head {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    align-items: center;
    padding: 16px 20px;
  }
  .duel__names {
    flex: 1;
    min-width: 0;
  }
  .duel__name {
    font-size: 1.28rem;
    color: var(--band-title);
  }
  .duel__latin {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--band-muted);
  }
  .duel__when {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px 4px;
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--gold-300);
    background: rgb(10 5 7 / 0.45);
    border: 1px solid rgb(236 202 106 / 0.4);
  }
  .duel__when :global(svg) {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .duel__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 6px 20px 20px;
  }
  .duel__rows {
    font-size: 0.94rem;
  }
  .duel__rows th,
  .duel__rows td {
    padding: 9px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  .duel__rows th {
    width: 6.5em;
    font-weight: 700;
    color: var(--brand-600);
  }
  .duel__reward {
    display: grid;
    gap: 4px;
    margin-top: auto;
    padding: 12px 14px;
    font-size: 0.94rem;
    background: linear-gradient(180deg, #fbf3d6, var(--gold-100));
    border: 1px solid #e2c977;
    border-left: 4px solid var(--gold-400);
  }
  .duel__rows + .duel__reward {
    margin-top: 16px;
  }
  .duel__reward-h {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--gold-700);
  }
  .duel__reward-h :global(svg) {
    width: 16px;
    height: 16px;
  }
  .duel__reward b {
    display: inline-block;
    min-width: 6.5em;
    color: var(--ink-strong);
  }
  .duel__common {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 32px;
    margin-top: 18px;
    font-size: 0.93rem;
    color: var(--ink-2);
  }

  /* ---------- 週二 PvP 區域 ---------- */
  .zone-band {
    padding-bottom: calc(var(--section-y) + max(6.67vw, 64px));
  }
  .zone {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 24px clamp(24px, 4vw, 48px);
    align-items: center;
  }
  /* 日期牌：酒紅底、金色細框 */
  .zone__date {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px 30px 26px;
    color: #fff;
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(230 90 100 / 0.36), transparent 62%),
      linear-gradient(160deg, #8a1828 0%, #4a0e17 60%, #2a080e 100%);
    border: 1px solid #0b0508;
    box-shadow:
      0 0 0 1px rgb(236 202 106 / 0.35),
      0 24px 46px -22px rgb(0 0 0 / 0.9),
      0 0 60px rgb(207 58 76 / 0.22);
  }
  .zone__date span {
    padding: 0 10px;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.7;
    color: #241a03;
    background: var(--gold-400);
  }
  .zone__date b {
    font-size: 2.3rem;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 4px 18px rgb(0 0 0 / 0.5);
  }
  .zone__date i {
    width: 2px;
    height: 18px;
    background: var(--gold-400);
  }
  .zone__title {
    font-size: clamp(1.4rem, 1.15rem + 1vw, 1.85rem);
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .zone__desc {
    margin-top: 8px;
    max-width: 46em;
  }
  .zone__desc b {
    color: var(--gold-300);
  }
  .zone__list {
    margin-top: 12px;
    max-width: 52em;
    font-size: 0.93rem;
    color: var(--ink-2);
  }

  /* 時間軸 */
  .zone__line {
    max-width: 640px;
    margin-top: 22px;
    padding-inline: 20px;
  }
  .zone__line-cap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 -20px 10px;
    font-size: 0.82rem;
    color: var(--ink-3);
  }
  .zone__line-cap i {
    width: 18px;
    height: 8px;
    background: linear-gradient(180deg, var(--gold-300), var(--gold-500));
    box-shadow: 0 0 10px rgb(236 202 106 / 0.6);
  }
  .zone__track {
    position: relative;
    height: 10px;
    background: linear-gradient(90deg, var(--brand-700), var(--brand-400) 50%, var(--brand-700));
    border: 1px solid rgb(255 200 190 / 0.35);
    box-shadow: 0 0 22px rgb(220 60 76 / 0.45);
  }
  .zone__spawn {
    position: absolute;
    top: -4px;
    bottom: -4px;
    width: 12.5%;
    background: linear-gradient(180deg, var(--gold-300), var(--gold-500));
    border: 1px solid #fff3c4;
    box-shadow: 0 0 16px rgb(236 202 106 / 0.75);
  }
  .zone__ticks {
    position: relative;
    height: 2.1em;
    margin-top: 8px;
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .zone__ticks li {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .zone__ticks li::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -7px;
    height: 5px;
    border-left: 1px solid rgb(255 236 228 / 0.35);
  }
  .zone__ticks .is-hit {
    font-weight: 700;
    color: var(--gold-300);
  }

  /* ---------- 英雄、城堡與血盟 ---------- */
  .glory {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .glory__item {
    position: relative;
    padding: 20px 20px 20px;
    border-top: 3px solid var(--brand-500);
    transition:
      box-shadow 0.25s var(--ease),
      border-color 0.25s;
  }
  .glory__item:hover {
    box-shadow: var(--shadow-2);
  }
  .glory__head {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .glory__head :global(.medal) {
    --medal: 50px;
  }
  .glory__t {
    font-size: 1.18rem;
  }
  .glory__when {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--brand-600);
  }
  .glory__list {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--ink-2);
  }

  /* ---------- 首領與副本 ---------- */
  .e-boss {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .e-boss :global(.medal) {
    --medal: 30px;
    box-shadow: inset 0 0 0 1px rgb(236 202 106 / 0.6);
  }
  .e-lv {
    padding: 0 6px;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.7;
    white-space: nowrap;
    color: #241a03;
    background: var(--gold-400);
  }
  .e-table :global(.table td),
  .e-table :global(.table tbody th) {
    vertical-align: middle;
  }
  .e-sub {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin: 32px 0 14px;
    font-size: 1.2rem;
  }
  .e-sub span {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--ink-2);
  }
  .e-inst-sub {
    display: block;
    font-size: 0.82rem;
    font-weight: 400;
