---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import AwakenExplorer from '../components/AwakenExplorer.astro';
import CtaBand from '../components/CtaBand.astro';
import { featureGroups, rateBook } from '../data/features';
import { awakenClassCount } from '../data/classes';
import { site } from '../data/site';
import FeatureArt from '../components/FeatureArt.astro';

/** 每一章封面下半部的示意圖 */
type ArtKind = 'board' | 'auto' | 'awaken' | 'balance' | 'growth' | 'battle' | 'boss';
const chapterArt: Record<string, ArtKind> = {
  growth: 'growth',
  board: 'board',
  auto: 'auto',
  classes: 'balance',
  battle: 'battle',
  bosses: 'boss',
};

const toc = [
  ...featureGroups.map((g) => ({ id: g.id, label: g.title })),
  { id: 'awaken', label: '覺醒技能' },
  { id: 'rates', label: '倍率與規格' },
];
---

<Base title="伺服器特色" description="嗜血天堂II 經典服的完整特色：經驗 5 倍起、隨身布告欄、免費內掛、90 級覺醒技能、職業平衡調整、每週 PvP 活動與 96 級史詩首領。">
  <PageHero
    crumb="伺服器特色"
    title="伺服器特色"
    lead="經典的骨架，現代的便利"
    desc="保留天堂II經典版的節奏與職業體系，再加上隨身布告欄、免費內掛與 90 級覺醒技能。以下每一項，都來自伺服器實際設定。"
  />

  <!-- 本頁目錄：黏在頁首下方，捲動時標出目前所在的章節 -->
  <nav class="toc" aria-label="本頁目錄" data-toc>
    <div class="container">
      <ul class="toc__list">
        {
          toc.map((t, i) => (
            <li>
              <a href={`#${t.id}`}>
                <span class="toc__no tnum">{i + 1}</span>
                {t.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- 六個章節：左邊是酒紅色的章節封面，右邊是該章的特色 -->
  <section class="section" aria-label="伺服器特色一覽">
    <div class="container chaps">
      {
        featureGroups.map((g, gi) => (
          <section class:list={['chap', g.id === 'board' && 'chap--note']} id={g.id} aria-labelledby={`fg-${g.id}`}>
            <header class="chap__lead plate plate--frame">
              <p class="chap__no" aria-hidden="true">
                <span class="gem gem--gold">
                  <b>{gi + 1}</b>
                </span>
                <span class="chap__latin">{g.latin}</span>
              </p>
              <h2 class="chap__title" id={`fg-${g.id}`}>
                {g.title}
              </h2>
              <p class="chap__lede">{g.lede}</p>
              {chapterArt[g.id] && (
                <div class="chap__art" aria-hidden="true">
                  <FeatureArt kind={chapterArt[g.id]} align="start" />
                </div>
              )}
            </header>

            <ul class="fg">
              {g.items.map((f) => (
                <li class="fcard">
                  <span class="ibox" aria-hidden="true">
                    <Icon name={f.icon} />
                  </span>
                  <div class="fcard__body">
                    <h3 class="fcard__title">
                      {f.title}
                      {f.tag && <span class:list={['tag', f.tag === '免費' && 'tag--gold']}>{f.tag}</span>}
                    </h3>
                    <p class="fcard__desc">{f.desc}</p>
                    {f.cmd && (
                      <button class="fcard__cmd" type="button" data-copy={f.cmd} aria-label={`複製指令 ${f.cmd}`}>
                        <span class="cmd">{f.cmd}</span>
                        <Icon name="copy" />
                        <span data-copy-label>複製</span>
                      </button>
                    )}
                  </div>
                </li>
              ))}
            </ul>

            {g.id === 'board' && (
              <p class="note chap__note">
                <Icon name="shield" />
                <span>死亡、戰鬥中、紫名或紅名、PvP 活動與奧林匹亞中、交易或擺攤中、攻城區域與監獄內，無法使用布告欄的商店、輔助、傳送與服務。</span>
              </p>
            )}
          </section>
        ))
      }
    </div>
  </section>

  <section class="section section--white" id="awaken" aria-labelledby="awaken-title">
    <div class="container">
      <SectionHead
        title={`90 級覺醒技能（${awakenClassCount} 個職業）`}
        id="awaken-title"
        desc="每個三轉職業各有 1 個被動、1 個主動技能，移植自覺醒版本並依經典數值縮小。90 級學 Lv1、95 級學 Lv2、99 級學 Lv3，到等級自動學會；只有主職業學得到。斜線分隔的數字依序是 Lv1／Lv2／Lv3。"
      />
      <AwakenExplorer />
    </div>
  </section>

  <section class="section section--alt" id="rates" aria-labelledby="rates-title">
    <div class="container">
      <SectionHead title="倍率與規格" id="rates-title" desc="所有數值都取自伺服器設定檔。" />
      <div class="spec">
        <div>
          <div class="table-wrap">
            <table class="table">
              <caption class="sr-only">倍率</caption>
              <thead>
                <tr>
                  <th scope="col">項目</th>
                  <th scope="col">倍率</th>
                  <th scope="col">說明</th>
                </tr>
              </thead>
              <tbody>
                <tr class="spec__hero">
                  <th scope="row">{rateBook.hero.label}</th>
                  <td class="spec__v tnum">×{rateBook.hero.value}</td>
                  <td>{rateBook.hero.note}</td>
                </tr>
                {
                  rateBook.items.map((r) => (
                    <tr>
                      <th scope="row">{r.label}</th>
                      <td class="spec__v tnum">{`${r.prefix}${r.value}`}</td>
                      <td>{r.note}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="note spec__premium"><Icon name="crown" /><span>{rateBook.premium}</span></p>
        </div>
        <div class="table-wrap">
          <table class="table">
            <caption class="sr-only">伺服器規格</caption>
            <thead>
              <tr>
                <th scope="col">規格</th>
                <th scope="col">設定</th>
              </tr>
            </thead>
            <tbody>
              {
                site.specs.map(([k, v]) => (
                  <tr>
                    <th scope="row" class="spec__k">{k}</th>
                    <td>{v}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  /* 本頁目錄：標出目前捲到哪一章；目錄一列放不下時，把目前那一項捲進可見範圍 */
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const list = toc.querySelector<HTMLElement>('.toc__list');
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    let current = -2;
    let queued = false;

    const update = () => {
      queued = false;
      const stickTop = parseFloat(getComputedStyle(toc).top) || 0;
      toc.classList.toggle('is-stuck', toc.getBoundingClientRect().top <= stickTop + 0.5);

      // 章節的上緣捲過目錄下方就算「目前這一章」
      const line = stickTop + toc.offsetHeight + 26;
      let idx = -1;
      targets.forEach((el, i) => {
        if (el && el.getBoundingClientRect().top <= line) idx = i;
      });
      if (idx === current) return;
      current = idx;
      links.forEach((a, i) => {
        if (i === idx) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });

      const a = links[idx];
      if (a && list && list.scrollWidth > list.clientWidth) {
        const lr = list.getBoundingClientRect();
        const ar = a.getBoundingClientRect();
        if (ar.left < lr.left + 8 || ar.right > lr.right - 40) {
          list.scrollTo({ left: list.scrollLeft + ar.left - lr.left - 16, behavior: 'smooth' });
        }
      }
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  /* ---------- 本頁目錄 ---------- */
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 3px);
    z-index: 40;
    background: rgb(255 255 255 / 0.95);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.3s;
  }
  @supports (backdrop-filter: blur(8px)) {
    .toc {
      background: rgb(255 255 255 / 0.86);
      backdrop-filter: blur(10px) saturate(1.3);
    }
  }
  .toc:global(.is-stuck) {
    box-shadow: 0 12px 24px -18px rgb(40 22 26 / 0.55);
  }
  .toc__list {
    display: flex;
    gap: 6px;
    padding-block: 10px;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .toc__list::-webkit-scrollbar {
    display: none;
  }
  .toc__list li {
    flex: none;
  }
  .toc__list a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 4px;
    font-size: 0.92rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--ink);
    background: var(--surface-2);
    border: 1px solid var(--line);
    transition:
      border-color 0.2s,
      color 0.2s,
      background-color 0.2s;
  }
  .toc__list a:hover {
    color: var(--link);
    border-color: var(--brand-200);
  }
  .toc__no {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    font-size: 0.78rem;
    color: #fff;
    background: var(--brand-500);
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  /* 目前所在的章節 */
  .toc__list a[aria-current] {
    color: #fff;
    background: linear-gradient(180deg, #2b171d, #1a0e13);
    border-color: #0b0508;
  }
  .toc__list a[aria-current] .toc__no {
    color: #241a03;
    background: var(--gold-400);
  }

  /* ---------- 章節 ---------- */
  .chaps {
    display: grid;
    gap: clamp(22px, 3vw, 34px);
  }
  .chap {
    display: grid;
    grid-template-columns: 284px minmax(0, 1fr);
    gap: 14px;
  }

  /* 卡片下面還有一行提示的章節：封面往下延伸到提示那一列 */
  .chap--note {
    grid-template-rows: 1fr auto;
  }
  .chap--note .chap__lead {
    grid-row: 1 / span 2;
  }

  /* 章節封面 */
  .chap__lead {
    display: flex;
    flex-direction: column;
    padding: 28px 26px 24px;
  }
  .chap__no {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .chap__no .gem {
    --gem: 32px;
    margin: 7px 0 7px 7px;
  }
  .chap__latin {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(236 202 106 / 0.85);
  }
  .chap__title {
    margin-top: 18px;
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    line-height: 1.25;
    color: var(--band-title);
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.35);
  }
  .chap__lede {
    margin-top: 10px;
    font-size: 0.93rem;
    line-height: 1.85;
    color: #e6d3cc;
  }
  /* 封面下半部的示意圖：貼著底部，上面一條虛線 */
  .chap__art {
    margin-top: auto;
    padding-top: 26px;
  }
  .chap__art::before {
    content: '';
    display: block;
    margin-bottom: 22px;
    border-top: 1px dashed rgb(255 236 228 / 0.22);
  }

  /* 特色卡片：圖示在左、文字在右（封面比較高的時候，卡片會平均拉高來對齊） */
  .fg {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .fcard {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding: 16px 18px 17px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
    transition:
      border-color 0.25s,
      box-shadow 0.25s var(--ease);
  }
  .fcard:hover {
    border-color: var(--line-2);
    box-shadow: var(--shadow-2);
  }
  .fcard :global(.ibox) {
    transition:
      color 0.25s,
      background-color 0.25s,
      border-color 0.25s;
  }
  .fcard:hover :global(.ibox) {
    color: #fff;
    background: linear-gradient(180deg, var(--brand-400), var(--brand-600));
    border-color: var(--brand-700);
  }
  .fcard__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 1.06rem;
    line-height: 1.5;
  }
  .fcard__desc {
    margin-top: 3px;
    font-size: 0.92rem;
    line-height: 1.72;
    color: var(--ink-2);
  }
  .fcard__cmd {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    padding: 3px 10px 3px 3px;
    font-size: 0.82rem;
    color: var(--ink-2);
    background: var(--surface-2);
    border: 1px solid var(--line);
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .fcard__cmd :global(svg) {
    width: 14px;
    height: 14px;
  }
  .fcard__cmd:hover {
    color: var(--link);
    border-color: var(--brand-200);
  }
  .fcard__cmd:global(.is-copied) {
    color: var(--ok);
    border-color: #9fd3b4;
    background: var(--ok-bg);
  }
  .chap__note {
    grid-column: 2;
  }

  /* ---------- 倍率與規格 ---------- */
  .spec {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  .spec__v {
    font-weight: 700;
    color: var(--brand-600);
    white-space: nowrap;
  }
  .spec__hero .spec__v {
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1.35;
  }
  .spec__k {
    white-space: nowrap;
  }
  .spec__premium {
    margin-top: 12px;
  }

  @media (max-width: 1040px) {
    .toc__list {
      padding-right: 40px;
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent);
    }
    .spec {
      grid-template-columns: 1fr;
    }
  }
  /* 中等寬度：封面改成橫的，放在卡片上方 */
  @media (max-width: 980px) {
    .chap,
    .chap--note {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .chap__lead,
    .chap--note .chap__lead {
      grid-row: auto;
      padding: 22px 22px 20px;
    }
    .chap__title {
      margin-top: 12px;
      font-size: 1.55rem;
    }
    /* 文字在左、示意圖在右 */
    .chap__lead {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto 1fr;
      column-gap: 28px;
      align-items: start;
    }
    .chap__lede {
      max-width: 40em;
    }
    .chap__art {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: center;
      margin: 0 8px 0 0;
      padding-top: 0;
    }
    .chap__art::before {
      display: none;
    }
    .chap__note {
      grid-column: auto;
    }
  }
  @media (max-width: 640px) {
    .fg {
      grid-template-columns: 1fr;
    }
    /* 手機：封面只留標題與說明 */
    .chap__lead {
      display: flex;
    }
    .chap__art {
      display: none;
    }
  }
</style>
