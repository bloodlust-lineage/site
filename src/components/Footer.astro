---
/**
 * 頁尾：深色底，上緣是一排森林剪影（往上疊到前一個區塊），
 * 內容是品牌與伺服器時間、網站導覽、聲明
 */
import { site } from '../data/site';
import { url } from '../lib/url';
import Emblem from './Emblem.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="ft">
  <svg class="edge edge--trees" viewBox="0 0 2400 96" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <use href="#g-trees"></use>
  </svg>

  <div class="container ft__main">
    <div class="ft__brand">
      <a href={url('/')} class="ft__logo">
        <Emblem size={40} />
        <span>{site.name}<small>{site.edition}</small></span>
      </a>
      <p class="ft__tag">{site.tagline}</p>
      <p class="ft__clock">
        <Icon name="clock" />
        伺服器時間 <b class="tnum" data-server-clock>--:--:--</b>
      </p>
      <p class="ft__small">台灣時間（UTC+8）・每週一、四、六 21:00 例行重啟</p>
    </div>

    <nav class="ft__nav" aria-label="頁尾導覽">
      <p class="ft__h">網站導覽</p>
      <ul>
        {site.nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
        <li><a href={url('/download/')}>下載遊戲</a></li>
        <li>
          <a href={site.links.discord} target="_blank" rel="noopener">官方 Discord<span class="sr-only">（另開新視窗）</span></a>
        </li>
      </ul>
    </nav>

    <div class="ft__legal">
      <p class="ft__h">聲明</p>
      <p>Lineage II 與天堂II 為 NCSOFT Corporation 之註冊商標。本站為玩家社群自行營運的伺服器網站，與 NCSOFT 及其代理商無任何關聯。</p>
      <p>客服、BUG 回報與贊助諮詢，請洽 Discord 管理員。</p>
    </div>
  </div>

  <div class="ft__bar">
    <div class="container ft__bar-inner">
      <p>© {year} {site.name} 營運團隊</p>
      <p>
        圖示：<a href="https://game-icons.net" target="_blank" rel="noopener">game-icons.net</a>（Lorc、Delapouite、Skoll 等，CC BY 3.0）
      </p>
    </div>
  </div>
</footer>

<style>
  .ft {
    --edge: #0b0508;
    position: relative;
    margin-top: auto;
    color: var(--band-muted);
    background: #0b0508;
  }
  .ft__main {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr) minmax(0, 1.5fr);
    gap: 32px 48px;
    padding-block: 34px 36px;
    font-size: 0.92rem;
  }
  .ft__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #fff;
  }
  .ft__logo small {
    margin-left: 10px;
    padding: 0 6px;
    font-size: 0.6em;
    font-weight: 700;
    line-height: 1.6;
    vertical-align: middle;
    color: var(--gold-300);
    border: 1px solid rgb(236 202 106 / 0.5);
  }
  .ft__tag {
    margin-top: 10px;
    color: var(--band-text);
  }
  .ft__clock {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .ft__clock :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--gold-400);
  }
  .ft__clock b {
    font-size: 1.15rem;
    color: #fff;
  }
  .ft__small {
    margin-top: 2px;
    font-size: 0.85rem;
    color: #9c8a84;
  }
  .ft__h {
    margin-bottom: 12px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--gold-300);
  }
  .ft__nav ul {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 8px 28px;
  }
  .ft__nav a {
    font-weight: 700;
    color: var(--band-text);
    transition: color 0.15s;
  }
  .ft__nav a:hover {
    color: var(--gold-300);
  }
  .ft__legal {
    font-size: 0.86rem;
    line-height: 1.75;
  }
  .ft__legal p + p {
    margin-top: 6px;
  }
  .ft__bar {
    font-size: 0.82rem;
    color: #9c8a84;
    border-top: 1px solid var(--band-line);
  }
  .ft__bar-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    padding-block: 14px 18px;
  }
  .ft__bar a {
    color: var(--band-muted);
    text-decoration: underline;
    text-decoration-color: rgb(199 182 175 / 0.4);
    text-underline-offset: 3px;
  }
  .ft__bar a:hover {
    color: var(--gold-300);
  }
  @media (max-width: 960px) {
    .ft__main {
      grid-template-columns: 1fr 1fr;
    }
    .ft__legal {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .ft__main {
      grid-template-columns: 1fr;
    }
  }
</style>
