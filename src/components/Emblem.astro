---
/**
 * 嗜血天堂II 徽章：一柄長劍貫穿血月，劍尖滴落一滴血。
 * 也是網站圖示（public/favicon.svg 為同一圖形）。
 */
interface Props {
  size?: number;
  class?: string;
  /** 動態版：血月微微呼吸、血滴垂落 */
  animated?: boolean;
}
const { size = 40, class: cls = '', animated = false } = Astro.props;
const uid = `em${Math.random().toString(36).slice(2, 7)}`;
---

<svg
  class:list={['emblem', cls, { 'emblem--live': animated }]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id={`${uid}m`} cx="42%" cy="36%" r="70%">
      <stop offset="0" stop-color="#ff8a6a" />
      <stop offset=".38" stop-color="#d4253a" />
      <stop offset=".8" stop-color="#7a0d1e" />
      <stop offset="1" stop-color="#3d0610" />
    </radialGradient>
    <linearGradient id={`${uid}g`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f6e6bf" />
      <stop offset=".5" stop-color="#cfa96a" />
      <stop offset="1" stop-color="#7c5d31" />
    </linearGradient>
    <linearGradient id={`${uid}b`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e8475a" />
      <stop offset="1" stop-color="#7d0c1e" />
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="30.2" fill="#0b0609" stroke={`url(#${uid}g)`} stroke-width="1.4" />
  <circle cx="32" cy="32" r="26.6" fill="none" stroke={`url(#${uid}g)`} stroke-width=".6" opacity=".55" />
  <circle class="emblem__moon" cx="32" cy="30" r="16.5" fill={`url(#${uid}m)`} />
  <path
    d="M32 4.6 34.3 17.5V38.6L32 45.6 29.7 38.6V17.5Z"
    fill="#0b0609"
    stroke={`url(#${uid}g)`}
    stroke-width=".9"
    stroke-linejoin="round"
  />
  <path d="M22.6 37.4 32 35.6l9.4 1.8L32 39.6Z" fill={`url(#${uid}g)`} />
  <path class="emblem__drop" d="M32 47.6c1.4 2.3 3.6 4.9 3.6 7a3.6 3.6 0 0 1-7.2 0c0-2.1 2.2-4.7 3.6-7Z" fill={`url(#${uid}b)`} />
</svg>

<style>
  .emblem {
    flex: none;
    overflow: visible;
  }
  /* 動態版：整個徽章以 GPU 合成的光暈呼吸（不動 SVG 內部元素，避免主執行緒重繪） */
  .emblem--live {
    animation: emblem-glow 5s ease-in-out infinite;
    will-change: filter;
  }
  @keyframes emblem-glow {
    0%,
    100% {
      filter: drop-shadow(0 0 0 rgb(220 47 69 / 0));
    }
    50% {
      filter: drop-shadow(0 0 14px rgb(220 47 69 / 0.55));
    }
  }
</style>
