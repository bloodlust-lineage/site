---
/**
 * 區塊標題：左側紅金色條＋標題，下面一行說明；右側可放按鈕或連結（預設插槽）
 * 顏色跟著所在區塊走（深色區塊會自動換成淺色字）。
 */
interface Props {
  title: string;
  desc?: string;
  id?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
}
const { title, desc, id, align = 'left', as: Tag = 'h2' } = Astro.props;
const hasAside = Astro.slots.has('default');
---

<header class:list={['sh', align === 'center' && 'sh--center']}>
  <div class="sh__text">
    <Tag class="sh__title" id={id}>{title}</Tag>
    {desc && <p class="sh__desc">{desc}</p>}
  </div>
  {hasAside && <div class="sh__aside"><slot /></div>}
</header>

<style>
  .sh {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 28px;
  }
  .sh__text {
    min-width: 0;
    flex: 1 1 420px;
  }
  .sh__title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(1.5rem, 1.24rem + 1.1vw, 1.95rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }
  /* 色條：一道血紅＋一條細金線 */
  .sh__title::before {
    content: '';
    width: 10px;
    height: 1.02em;
    flex: none;
    background: linear-gradient(90deg, var(--brand-500) 0 6px, transparent 6px 8px, var(--gold-400) 8px 10px);
  }
  .sh__desc {
    margin-top: 8px;
    max-width: 62em;
    color: var(--ink-2);
  }
  .sh__aside {
    flex: none;
  }
  .sh--center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .sh--center .sh__text {
    flex: none;
  }
  .sh--center .sh__title {
    justify-content: center;
  }
  .sh--center .sh__desc {
    margin-inline: auto;
  }
</style>
