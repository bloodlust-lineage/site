---
/**
 * 首頁「倍率一覽」
 */
import { rateBook } from '../../data/features';
import { url } from '../../lib/url';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
---

<section class="section section--alt" id="rates" aria-labelledby="hr-title">
  <div class="container">
    <SectionHead title="倍率一覽" id="hr-title" desc="所有倍率都取自伺服器實際設定。不追求一夜滿等，也不讓你在同一張地圖耗上一個月。">
      <a class="link" href={url('/features/#rates')}>完整規格<Icon name="arrow" /></a>
    </SectionHead>

    <div class="rt">
      <div class="rt__hero">
        <p class="rt__label">{rateBook.hero.label}</p>
        <p class="rt__big tnum"><span aria-hidden="true">×</span><span class="sr-only">倍率</span>{rateBook.hero.value}</p>
        <p class="rt__note">{rateBook.hero.note}</p>
      </div>
      <ul class="rt__list">
        {
          rateBook.items.map((r) => (
            <li class="rt__item">
              <p class="rt__val tnum">
                <span class="rt__pre">{r.prefix}</span>
                {r.value}
              </p>
              <p class="rt__name">{r.label}</p>
              <p class="rt__note">{r.note}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="note rt__premium"><Icon name="crown" /><span>{rateBook.premium}</span></p>
  </div>
</section>

<style>
  .rt {
    display: grid;
    grid-template-columns: minmax(200px, 0.26fr) 1fr;
    gap: 12px;
  }
  .rt__hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--brand-500);
  }
  .rt__label {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .rt__big {
    margin-top: 2px;
    font-size: 4.5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--brand-500);
  }
  .rt__big span[aria-hidden] {
    font-size: 0.5em;
    margin-right: 2px;
  }
  .rt__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .rt__item {
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .rt__val {
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ink-strong);
  }
  .rt__pre {
    margin-right: 2px;
    font-size: 0.55em;
    color: var(--brand-500);
  }
  .rt__name {
    margin-top: 6px;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .rt__note {
    margin-top: 2px;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .rt__premium {
    margin-top: 16px;
  }
  @media (max-width: 900px) {
    .rt {
      grid-template-columns: 1fr;
    }
    .rt__hero {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-areas: 'big label' 'big note';
      align-items: center;
      column-gap: 18px;
    }
    .rt__label {
      grid-area: label;
      align-self: end;
    }
    .rt__big {
      grid-area: big;
    }
    .rt__hero .rt__note {
      grid-area: note;
      align-self: start;
    }
    .rt__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
