---
/**
 * 首頁「90 級覺醒・七大職業體系」：點選後到特色頁直接打開該體系的技能
 */
import { archetypes, awakenClassCount } from '../../data/classes';
import { url } from '../../lib/url';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
---

<section class="section" id="awaken" aria-labelledby="hc-title">
  <div class="container">
    <SectionHead
      title="90 級覺醒・七大職業體系"
      id="hc-title"
      align="center"
      desc={`${awakenClassCount} 個三轉職業各自獲得 1 個被動、1 個主動技能，移植自覺醒版本並依經典數值縮放。點選職業體系，查看全部技能。`}
    />
    <ul class="cl">
      {
        archetypes.map((a) => (
          <li>
            <a class="cl__item card lift" href={url(`/features/#awaken-${a.id}`)}>
              <span class="cl__gem" aria-hidden="true">
                <Icon name={a.icon} />
              </span>
              <span class="cl__name">{a.name}</span>
              <span class="cl__count">{a.classes.length} 個職業</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="cl__note">
      四種弓手共用<b>多重箭矢</b>、<b>箭雨風暴</b>兩招範圍攻擊；三種匕首職業共用<b>闇影奇襲</b>。90、95、99 級自動學會，只有主職業學得到。
    </p>
  </div>
</section>

<style>
  .cl {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .cl__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 136px;
    padding: 32px 8px 14px;
  }
  /* 菱形徽記：深色底、金色圖示，滑過時轉成血紅並發光 */
  .cl__gem {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 24px;
    color: var(--gold-300);
    background: linear-gradient(135deg, #33202a, #150b0f);
    border: 1px solid #0a0506;
    box-shadow:
      inset 0 0 0 2px rgb(236 202 106 / 0.3),
      0 8px 16px -8px rgb(40 22 26 / 0.6);
    transform: rotate(45deg);
    transition:
      background-color 0.25s,
      box-shadow 0.25s,
      transform 0.35s var(--ease);
  }
  .cl__gem :global(svg) {
    width: 34px;
    height: 34px;
    transform: rotate(-45deg);
  }
  .cl__item:hover .cl__gem {
    background: linear-gradient(135deg, var(--brand-400), var(--brand-700));
    box-shadow:
      inset 0 0 0 2px rgb(255 220 200 / 0.4),
      0 0 24px rgb(207 58 76 / 0.55);
    transform: rotate(45deg) scale(1.06);
  }
  .cl__name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink-strong);
    transition: color 0.2s;
  }
  .cl__item:hover .cl__name {
    color: var(--link);
  }
  .cl__count {
    font-size: 0.84rem;
    color: var(--ink-3);
  }
  .cl__note {
    max-width: 46em;
    margin: 22px auto 0;
    font-size: 0.93rem;
    text-align: center;
    text-wrap: balance;
    color: var(--ink-2);
  }
  .cl__note b {
    color: var(--ink-strong);
  }
  @media (max-width: 560px) {
    .cl {
      gap: 8px;
    }
    .cl__item {
      width: calc((100vw - var(--gutter) * 2 - 16px) / 3);
      min-width: 96px;
    }
  }
</style>
