---
/**
 * 首頁「裝備之路」：無等級 → D → C → B → A → S → 王朝 → 封印中
 * 依據：冒險手冊「裝備等級與成長路線」。尚未開放的階段不寫名稱，只以封印呈現（決策 D16）。
 * 每一階是一顆菱形寶石，串在一條漸層的進度線上。
 */
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { url } from '../../lib/url';
import { gearTiers as tiers } from '../../data/gear';
---

<section class="section section--alt" id="gear" aria-labelledby="hg-title">
  <div class="container">
    <SectionHead title="裝備之路" id="hg-title" desc="從無等級一路走到王朝。本服關閉越級裝備懲罰，等級還沒到也能先穿上高一級的裝備。">
      <a class="link" href={url('/handbook/#gear-progression')}>裝備成長路線<Icon name="arrow" /></a>
    </SectionHead>

    <ol class="gt-track">
      {
        tiers.map((t) => (
          <li class="gt" style={`--c:${t.c}`}>
            <span class="gt__gem" aria-hidden="true">
              <b class:list={[!/[A-Z]/.test(t.g) && 'gt__cjk']}>{t.g}</b>
            </span>
            <div class="gt__card">
              <p class="gt__name">{t.name}</p>
              <p class="gt__lv tnum">Lv. {t.lv}</p>
              <p class="gt__how">{t.how}</p>
            </div>
          </li>
        ))
      }
      <li class="gt gt--sealed">
        <span class="gt__gem" aria-hidden="true"><Icon name="lock" /></span>
        <div class="gt__card">
          <p class="gt__name">封印中</p>
          <p class="gt__lv">Lv. ???</p>
          <p class="gt__how">更古老的力量仍在沉睡，將隨伺服器進度逐一解封。</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .gt-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 8px;
    padding-top: 6px;
  }
  /* 進度線：穿過每顆寶石的中心 */
  .gt-track::before {
    content: '';
    position: absolute;
    left: 6.25%;
    right: 6.25%;
    top: 27px;
    height: 3px;
    background: linear-gradient(90deg, #7d8592, #3a70c8 15%, #2a8f60 29%, #b77f12 43%, #c64d36 57%, #7f4fc9 71%, #9a7420 86%, var(--brand-500));
    opacity: 0.55;
  }
  .gt {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* 菱形寶石 */
  .gt__gem {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin: 6px 0 -11px;
    color: #fff;
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 78%, #fff), var(--c) 55%, color-mix(in srgb, var(--c) 72%, #000));
    border: 1px solid color-mix(in srgb, var(--c) 55%, #000);
    box-shadow:
      0 0 0 4px var(--bg-alt),
      0 6px 14px -4px color-mix(in srgb, var(--c) 60%, transparent);
    transform: rotate(45deg);
    transition: transform 0.35s var(--ease);
  }
  .gt:hover .gt__gem {
    transform: rotate(45deg) scale(1.12);
  }
  .gt__gem b,
  .gt__gem :global(svg) {
    transform: rotate(-45deg);
  }
  .gt__gem b {
    font-size: 1.05rem;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.35);
  }
  .gt__gem .gt__cjk {
    font-size: 0.9rem;
  }
  .gt__gem :global(svg) {
    width: 18px;
    height: 18px;
  }
  .gt__card {
    flex: 1;
    width: 100%;
    padding: 26px 8px 14px;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--c);
    box-shadow: var(--shadow-1);
    transition: box-shadow 0.25s var(--ease);
  }
  .gt:hover .gt__card {
    box-shadow: var(--shadow-2);
  }
  .gt__name {
    font-weight: 700;
    color: var(--ink-strong);
  }
  .gt__lv {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--c);
  }
  .gt__how {
    margin-top: 6px;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .gt--sealed {
    --c: var(--brand-500);
  }
  .gt--sealed .gt__gem {
    color: var(--brand-500);
    background: #fff;
    border: 1px dashed var(--brand-500);
    box-shadow:
      0 0 0 4px var(--bg-alt),
      0 0 18px rgb(207 58 76 / 0.45);
  }
  .gt--sealed .gt__card {
    background: var(--brand-50);
    border-style: dashed;
    border-color: var(--brand-200);
    border-top: 3px solid var(--brand-500);
  }
  .gt--sealed .gt__name {
    color: var(--brand-700);
  }

  @media (max-width: 1040px) {
    .gt-track {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: 14px;
    }
    .gt-track::before {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .gt-track {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-top: 0;
    }
    /* 手機：寶石在左，文字在右，直的進度線串起來 */
    .gt-track::before {
      display: block;
      left: 28px;
      right: auto;
      top: 20px;
      bottom: 20px;
      width: 3px;
      height: auto;
      background: linear-gradient(180deg, #7d8592, #3a70c8 15%, #2a8f60 29%, #b77f12 43%, #c64d36 57%, #7f4fc9 71%, #9a7420 86%, var(--brand-500));
    }
    .gt {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }
    .gt__gem {
      flex: none;
      width: 30px;
      height: 30px;
      margin: 0 16px 0 14px;
    }
    .gt__card {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: 'name lv' 'how how';
      column-gap: 12px;
      padding: 10px 14px;
      text-align: left;
      border-top-width: 1px;
      border-left: 3px solid var(--c);
    }
    .gt--sealed .gt__card {
      border-top-width: 1px;
      border-left: 3px solid var(--brand-500);
    }
    .gt__name {
      grid-area: name;
    }
    .gt__lv {
      grid-area: lv;
    }
    .gt__how {
      grid-area: how;
      margin-top: 2px;
    }
  }
</style>
