---
/**
 * 首頁「伺服器特色」：四張主打卡片（上方是 CSS 畫的小示意圖）＋更多便利
 */
import { homeExtras } from '../../data/features';
import { awakenClassCount } from '../../data/classes';
import { url } from '../../lib/url';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
---

<section class="section" id="features" aria-labelledby="hf-title">
  <div class="container">
    <SectionHead
      title="伺服器特色"
      id="hf-title"
      desc="保留天堂II經典版的節奏與職業體系，再把跑圖、找 NPC、補狀態這些瑣事，交給隨身布告欄與內掛。"
    />

    <ul class="fc-grid">
      <li>
        <a class="fc" href={url('/features/#board')}>
          <div class="fc__art" aria-hidden="true">
            <div class="a-board">
              <p class="a-board__keys"><kbd>Alt</kbd><span>+</span><kbd>B</kbd></p>
              <p class="a-board__tabs"><span class="is-on">傳送</span><span>輔助</span><span>商店</span><span>倉庫</span></p>
            </div>
          </div>
          <div class="fc__body">
            <h3 class="fc__title"><Icon name="board" />隨身布告欄</h3>
            <p class="fc__desc">按 Alt+B 打開。商店、輔助、傳送、倉庫隨身帶著走，全地圖傳送免費。</p>
          </div>
        </a>
      </li>
      <li>
        <a class="fc" href={url('/features/#auto')}>
          <div class="fc__art" aria-hidden="true">
            <div class="a-bot">
              <p class="a-bot__bar"><span>自動狩獵</span><span class="cmd">.內掛</span></p>
              <ul class="a-bot__list">
                <li>自動找怪</li>
                <li>自動回收</li>
                <li>自動喝水</li>
              </ul>
            </div>
          </div>
          <div class="fc__body">
            <h3 class="fc__title"><Icon name="bot" />內掛自動狩獵</h3>
            <p class="fc__desc">輸入 .內掛 開啟，免費、所有等級都能用。找怪、技能策略、補血補藍、自動回收。</p>
          </div>
        </a>
      </li>
      <li>
        <a class="fc" href={url('/features/#awaken')}>
          <div class="fc__art" aria-hidden="true">
            <div class="a-aw">
              <ol class="a-aw__lv"><li>Lv.90</li><li>Lv.95</li><li>Lv.99</li></ol>
              <p class="a-aw__cap">被動＋主動，到等級自動學會</p>
            </div>
          </div>
          <div class="fc__body">
            <h3 class="fc__title"><Icon name="awaken" />90 級覺醒技能</h3>
            <p class="fc__desc">{awakenClassCount} 個三轉職業各有 1 個被動、1 個主動技能，不用 SP、不用技能書。</p>
          </div>
        </a>
      </li>
      <li>
        <a class="fc" href={url('/features/#classes')}>
          <div class="fc__art" aria-hidden="true">
            <div class="a-bal">
              <p class="a-bal__name">爆射箭<span>威力</span></p>
              <p class="a-bal__bar a-bal__bar--old"><span class="tnum">1,326</span></p>
              <p class="a-bal__bar a-bal__bar--new"><span class="tnum">3,000</span></p>
            </div>
          </div>
          <div class="fc__body">
            <h3 class="fc__title"><Icon name="warrior" />職業再平衡</h3>
            <p class="fc__desc">匕首正面也能背刺，弓手範圍技冷卻從 30 秒縮短為 10 秒，冷門職業也有舞台。</p>
          </div>
        </a>
      </li>
    </ul>

    <div class="extras">
      <p class="extras__h">還有：</p>
      <ul class="extras__list">
        {
          homeExtras.map((f) => (
            <li class="chip" title={f.desc}>
              <Icon name={f.icon} />
              {f.title}
            </li>
          ))
        }
      </ul>
      <a class="link extras__more" href={url('/features/')}>全部伺服器特色<Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .fc-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .fc {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .fc:hover {
    border-color: var(--line-2);
    box-shadow: 0 2px 8px rgb(16 20 24 / 0.08);
  }
  .fc:hover .fc__title {
    color: var(--link);
  }
  .fc__art {
    display: grid;
    place-items: center;
    height: 150px;
    padding: 14px;
    background:
      linear-gradient(rgb(120 90 70 / 0.06) 1px, transparent 1px) 0 0 / 18px 18px,
      linear-gradient(90deg, rgb(120 90 70 / 0.06) 1px, transparent 1px) 0 0 / 18px 18px,
      #f4efe8;
    border-bottom: 1px solid var(--line);
  }
  .fc__body {
    padding: 14px 16px 16px;
  }
  .fc__title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    transition: color 0.15s;
  }
  .fc__title :global(svg) {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--brand-500);
  }
  .fc__desc {
    margin-top: 6px;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  /* 示意圖：布告欄 */
  .a-board {
    display: grid;
    justify-items: center;
    gap: 14px;
  }
  .a-board__keys {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--ink-3);
  }
  .a-board__keys kbd {
    min-width: 46px;
    padding: 4px 10px;
    font-size: 1.15rem;
    text-align: center;
  }
  .a-board__tabs {
    display: flex;
    border: 1px solid var(--line-2);
    background: #fff;
    font-size: 0.8rem;
  }
  .a-board__tabs span {
    padding: 3px 9px;
    color: var(--ink-2);
  }
  .a-board__tabs span + span {
    border-left: 1px solid var(--line);
  }
  .a-board__tabs .is-on {
    color: #fff;
    background: var(--brand-500);
  }

  /* 示意圖：內掛 */
  .a-bot {
    width: min(190px, 100%);
    font-size: 0.82rem;
    background: #fff;
    border: 1px solid var(--line-2);
  }
  .a-bot__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 8px;
    font-weight: 700;
    color: #fff;
    background: var(--band-800);
  }
  .a-bot__bar .cmd {
    font-size: 0.78rem;
  }
  .a-bot__list {
    display: grid;
    gap: 2px;
    padding: 6px 8px 8px;
  }
  .a-bot__list li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .a-bot__list li::before {
    content: '✓';
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    background: var(--brand-500);
  }

  /* 示意圖：覺醒 */
  .a-aw {
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .a-aw__lv {
    position: relative;
    display: flex;
    gap: 18px;
  }
  .a-aw__lv::before {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    top: 50%;
    height: 2px;
    background: var(--gold-500);
  }
  .a-aw__lv li {
    position: relative;
    padding: 4px 8px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #241a03;
    background: var(--gold-400);
    border: 1px solid #8a6a12;
  }
  .a-aw__lv li:last-child {
    color: #fff;
    background: var(--brand-500);
    border-color: var(--brand-700);
  }
  .a-aw__cap {
    font-size: 0.8rem;
    color: var(--ink-2);
  }

  /* 示意圖：平衡 */
  .a-bal {
    display: grid;
    gap: 6px;
    width: min(200px, 100%);
  }
  .a-bal__name {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .a-bal__name span {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--ink-3);
  }
  .a-bal__bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 20px;
    padding: 0 6px;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .a-bal__bar--old {
    width: 44%;
    color: var(--ink-2);
    background: repeating-linear-gradient(135deg, #d6d2cc 0 4px, #e6e2dc 4px 8px);
  }
  .a-bal__bar--new {
    width: 100%;
    color: #fff;
    background: var(--brand-500);
  }

  /* 更多便利 */
  .extras {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-top: 20px;
  }
  .extras__h {
    font-weight: 700;
    color: var(--ink-strong);
  }
  .extras__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .extras__more {
    margin-left: auto;
  }

  @media (max-width: 1040px) {
    .fc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .fc-grid {
      grid-template-columns: 1fr;
    }
    .fc__art {
      height: 130px;
    }
    .extras__more {
      margin-left: 0;
    }
  }
</style>
