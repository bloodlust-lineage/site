---
/**
 * 首頁「伺服器特色」：四張主打卡片（上方是深色發光的遊戲介面示意圖，見 FeatureArt）＋八項便利功能
 */
import { homeExtras } from '../../data/features';
import { awakenClassCount } from '../../data/classes';
import { url } from '../../lib/url';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import FeatureArt from '../FeatureArt.astro';
---

<section class="section" id="features" aria-labelledby="hf-title">
  <div class="container">
    <SectionHead
      title="伺服器特色"
      id="hf-title"
      desc="保留天堂II經典版的節奏與職業體系，再把跑圖、找 NPC、補狀態這些瑣事，交給隨身布告欄與內掛。"
    />

    <ul class="fc-grid">
      <li>
        <a class="fc card lift" href={url('/features/#board')}>
          <div class="fc__art" aria-hidden="true">
            <Icon name="board" class="fc__ghost" />
            <FeatureArt kind="board" />
          </div>
          <div class="fc__body">
            <h3 class="fc__title">隨身布告欄</h3>
            <p class="fc__desc">按 Alt+B 打開。商店、輔助、傳送、倉庫隨身帶著走，全地圖傳送免費。</p>
            <span class="link fc__more">了解更多<Icon name="arrow" /></span>
          </div>
        </a>
      </li>
      <li>
        <a class="fc card lift" href={url('/features/#auto')}>
          <div class="fc__art" aria-hidden="true">
            <Icon name="bot" class="fc__ghost" />
            <FeatureArt kind="auto" />
          </div>
          <div class="fc__body">
            <h3 class="fc__title">內掛自動狩獵</h3>
            <p class="fc__desc">輸入 .內掛 開啟，免費、所有等級都能用。找怪、技能策略、補血補藍、自動回收。</p>
            <span class="link fc__more">了解更多<Icon name="arrow" /></span>
          </div>
        </a>
      </li>
      <li>
        <a class="fc card lift" href={url('/features/#awaken')}>
          <div class="fc__art" aria-hidden="true">
            <Icon name="awaken" class="fc__ghost" />
            <FeatureArt kind="awaken" />
          </div>
          <div class="fc__body">
            <h3 class="fc__title">90 級覺醒技能</h3>
            <p class="fc__desc">{awakenClassCount} 個三轉職業各有 1 個被動、1 個主動技能，不用 SP、不用技能書。</p>
            <span class="link fc__more">了解更多<Icon name="arrow" /></span>
          </div>
        </a>
      </li>
      <li>
        <a class="fc card lift" href={url('/features/#classes')}>
          <div class="fc__art" aria-hidden="true">
            <Icon name="warrior" class="fc__ghost" />
            <FeatureArt kind="balance" />
          </div>
          <div class="fc__body">
            <h3 class="fc__title">職業再平衡</h3>
            <p class="fc__desc">匕首正面也能背刺，弓手範圍技冷卻從 30 秒縮短為 10 秒，冷門職業也有舞台。</p>
            <span class="link fc__more">了解更多<Icon name="arrow" /></span>
          </div>
        </a>
      </li>
    </ul>

    <div class="ex">
      <div class="ex__head">
        <h3 class="ex__h">還有這些，讓冒險更從容</h3>
        <a class="link" href={url('/features/')}>全部伺服器特色<Icon name="arrow" /></a>
      </div>
      <ul class="ex__grid">
        {
          homeExtras.map((f) => (
            <li class="ex__item">
              <span class="ex__icon" aria-hidden="true">
                <Icon name={f.icon} />
              </span>
              <div>
                <p class="ex__t">{f.title}</p>
                <p class="ex__d">{f.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .fc-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .fc {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  /* 示意圖：深色面板，右上有紅光，角落是很淡的大圖示 */
  .fc__art {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    height: 172px;
    padding: 16px;
    color: var(--band-text);
    background:
      radial-gradient(1.5px 1.5px at 14% 22%, rgb(255 232 222 / 0.5), transparent 60%),
      radial-gradient(1.5px 1.5px at 31% 74%, rgb(255 232 222 / 0.3), transparent 60%),
      radial-gradient(1.5px 1.5px at 68% 14%, rgb(255 232 222 / 0.45), transparent 60%),
      radial-gradient(1.5px 1.5px at 88% 62%, rgb(255 232 222 / 0.3), transparent 60%),
      radial-gradient(110% 90% at 88% -12%, rgb(196 52 68 / 0.55), transparent 62%),
      linear-gradient(180deg, #1a0d12, #30121c);
  }
  .fc__art :global(.fc__ghost) {
    position: absolute;
    right: -22px;
    bottom: -30px;
    width: 150px;
    height: 150px;
    color: rgb(255 236 228 / 0.06);
    transition: transform 0.5s var(--ease), color 0.5s;
  }
  .fc:hover :global(.fc__ghost) {
    transform: scale(1.08) rotate(-4deg);
    color: rgb(255 236 228 / 0.1);
  }
  .fc__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 18px 16px;
  }
  .fc__title {
    font-size: 1.12rem;
    transition: color 0.2s;
  }
  .fc:hover .fc__title {
    color: var(--link);
  }
  .fc__desc {
    margin-top: 6px;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .fc__more {
    margin-top: auto;
    padding-top: 12px;
    font-size: 0.9rem;
  }
  .fc:hover .fc__more :global(svg) {
    transform: translateX(3px);
  }

  /* 八項便利功能 */
  .ex {
    margin-top: 28px;
  }
  .ex__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 20px;
    margin-bottom: 12px;
  }
  .ex__h {
    font-size: 1.08rem;
  }
  .ex__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .ex__item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
  }
  .ex__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    color: var(--brand-500);
    background: var(--brand-50);
    border: 1px solid #ecc9ce;
  }
  .ex__icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .ex__t {
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink-strong);
  }
  .ex__d {
    margin-top: 2px;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  @media (max-width: 1040px) {
    .fc-grid,
    .ex__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .fc-grid,
    .ex__grid {
      grid-template-columns: 1fr;
    }
    .fc__art {
      height: 150px;
    }
  }
</style>
