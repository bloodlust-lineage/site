---
/**
 * 首頁「怎麼開始」＋「本週戰場」（依台灣時間即時標出下一場）
 */
import { journey } from '../../data/guide';
import { schedule, weekdays } from '../../data/schedule';
import { url } from '../../lib/url';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';

/** 首頁只列玩家會參加的活動（不含維護、重置） */
const show = ['pvp-zone', 'siege', 'last-hero', 'zaken', 'tvt', 'olympiad', 'antharas'];
const dayText = (days: number[]) =>
  days.length === 7 ? '每天' : days.length === 6 && !days.includes(7) ? '週一～六' : days.map((d) => weekdays[d - 1]).join('、');
const rows = schedule
  .filter((e) => show.includes(e.id))
  .sort((a, b) => a.start.localeCompare(b.start) || a.days[0] - b.days[0])
  .map((e) => ({ id: e.id, title: e.title, when: `${dayText(e.days)} ${e.start}${e.end ? `～${e.end}` : ''}` }));
---

<section class="section section--white" aria-label="怎麼開始與本週戰場">
  <div class="container sw">
    <div class="sw__col">
      <SectionHead title="怎麼開始" id="hs-title" desc="不用註冊、不用跑任務，四個步驟就能進入遊戲。" />
      <ol class="sw__steps">
        {
          journey.map((s, i) => (
            <li class="sw__step">
              <span class="num">{i + 1}</span>
              <div class="sw__card">
                <span class="sw__ico" aria-hidden="true">
                  <Icon name={s.icon} />
                </span>
                <div>
                  <p class="sw__t">{s.title}</p>
                  <p class="sw__d">{s.desc}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="sw__btns">
        <a class="btn btn--primary" href={url('/download/')}><Icon name="down" />下載遊戲</a>
        <a class="btn btn--light" href={url('/guide/')}>完整新手指南<Icon name="arrow" /></a>
      </div>
    </div>

    <div class="sw__col">
      <SectionHead title="本週戰場" id="hw-title" desc="週一到週六每晚都有活動，週日奇岩攻城。時間皆為伺服器時間（台灣時間）。" />
      <div class="wkm" data-week-mini>
        <div class="wkm__next" aria-live="polite">
          <div class="wkm__next-text">
            <span class="tag tag--next" data-mini-state>下一場</span>
            <p class="wkm__title" data-mini-title>每週戰場</p>
            <p class="wkm__when" data-mini-when></p>
          </div>
          <p class="wkm__count tnum" data-mini-count></p>
        </div>
        <ol class="wkm__list">
          {
            rows.map((r) => (
              <li class="wkm__ev" data-mini-ev={r.id}>
                <span class="wkm__mark" aria-hidden="true" />
                <span class="wkm__time tnum">{r.when}</span>
                <span class="wkm__name">{r.title}</span>
                <span class="tag tag--mute" data-mini-chip></span>
              </li>
            ))
          }
        </ol>
        <a class="link wkm__more" href={url('/events/')}>完整行事曆與活動規則<Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/schedule';
</script>

<style>
  .sw {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 48px;
  }

  /* 步驟：金色編號串在一條虛線上 */
  .sw__steps {
    position: relative;
    display: grid;
    gap: 10px;
  }
  .sw__steps::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 20px;
    bottom: 20px;
    border-left: 2px dashed var(--gold-400);
    opacity: 0.6;
  }
  .sw__step {
    position: relative;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 14px;
    align-items: center;
  }
  .sw__card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    padding: 12px 16px 13px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
    transition:
      box-shadow 0.25s var(--ease),
      border-color 0.25s;
  }
  .sw__step:hover .sw__card {
    border-color: var(--line-2);
    box-shadow: var(--shadow-2);
  }
  .sw__ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    color: var(--brand-500);
  }
  .sw__ico :global(svg) {
    width: 28px;
    height: 28px;
  }
  .sw__t {
    font-weight: 700;
    line-height: 1.75;
    color: var(--ink-strong);
  }
  .sw__d {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .sw__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 0 42px;
  }

  /* 本週戰場：上面一條深色的「下一場」倒數，下面是時間軸 */
  .wkm {
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-2);
  }
  .wkm__next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 16px 20px;
    color: var(--band-text);
    background:
      radial-gradient(80% 140% at 100% 0%, rgb(196 52 68 / 0.5), transparent 62%),
      linear-gradient(180deg, #1c0e13, #34121c);
    border-bottom: 3px solid var(--brand-500);
  }
  .wkm__next-text {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 10px;
    min-width: 0;
  }
  .wkm__title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #fff;
  }
  .wkm__when {
    grid-column: 1 / -1;
    margin-top: 2px;
    font-size: 0.88rem;
    color: var(--band-muted);
  }
  .wkm__when:empty {
    display: none;
  }
  .wkm__count {
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1;
    color: var(--gold-300);
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.5);
  }
  .wkm__count:empty {
    display: none;
  }
  .wkm__list {
    position: relative;
    display: grid;
    padding: 8px 20px 4px;
  }
  .wkm__list::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 26px;
    bottom: 22px;
    border-left: 2px dashed var(--line-2);
  }
  .wkm__ev {
    position: relative;
    display: grid;
    grid-template-columns: 16px 10.5em 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
  }
  .wkm__ev + .wkm__ev {
    border-top: 1px solid #efeae4;
  }
  .wkm__mark {
    width: 16px;
    height: 16px;
    background: #fff;
    border: 2px solid var(--line-2);
    transition: transform 0.3s var(--ease);
  }
  .wkm__ev.is-top .wkm__mark {
    background: var(--gold-400);
    border-color: #8a6a12;
    transform: rotate(45deg);
    box-shadow: 0 0 0 4px rgb(217 178 71 / 0.25);
  }
  .wkm__time {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .wkm__name {
    color: var(--ink-2);
  }
  .wkm__ev.is-top .wkm__name {
    font-weight: 700;
    color: var(--ink-strong);
  }
  .wkm :global(.tag:empty) {
    display: none;
  }
  .wkm__more {
    margin: 4px 20px 14px;
    padding-top: 10px;
  }

  @media (max-width: 960px) {
    .sw {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .wkm__ev {
      grid-template-columns: 16px 1fr auto;
      grid-template-areas: 'mark time chip' 'mark name chip';
      row-gap: 0;
    }
    .wkm__mark {
      grid-area: mark;
    }
    .wkm__time {
      grid-area: time;
    }
    .wkm__name {
      grid-area: name;
    }
    .wkm__ev :global([data-mini-chip]) {
      grid-area: chip;
    }
    .sw__btns {
      margin-left: 0;
    }
  }
</style>
